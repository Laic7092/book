{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "dist"
